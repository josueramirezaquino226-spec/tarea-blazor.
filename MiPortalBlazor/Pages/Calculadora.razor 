@page "/calculadora"

<PageTitle>Calculadora</PageTitle>

<div class="container my-4" style="max-width: 500px;">
    <div class="card shadow">
            <div class="card-header bg-primary text-white text-center">
                        <h3>Calculadora Básica</h3>
                                </div>
                                        <div class="card-body">
                                                    <div class="mb-3">
                                                                    <label class="form-label fw-bold">Primer Número:</label>
                                                                                    <input type="number" class="form-control" @bind="num1" placeholder="Ingresa el primer número" />
                                                                                                </div>

                                                                                                            <div class="mb-3">
                                                                                                                            <label class="form-label fw-bold">Segundo Número:</label>
                                                                                                                                            <input type="number" class="form-control" @bind="num2" placeholder="Ingresa el segundo número" />
                                                                                                                                                        </div>

                                                                                                                                                                    <div class="d-flex justify-content-between mb-4">
                                                                                                                                                                                    <button class="btn btn-outline-primary flex-fill me-1" @onclick="Sumar"><b>+</b> Sumar</button>
                                                                                                                                                                                                    <button class="btn btn-outline-primary flex-fill me-1" @onclick="Restar"><b>-</b> Restar</button>
                                                                                                                                                                                                                    <button class="btn btn-outline-primary flex-fill me-1" @onclick="Multiplicar"><b>×</b> Multiplicar</button>
                                                                                                                                                                                                                                    <button class="btn btn-outline-primary flex-fill" @onclick="Dividir"><b>÷</b> Dividir</button>
                                                                                                                                                                                                                                                </div>

                                                                                                                                                                                                                                                            <div class="alert alert-info text-center m-0">
                                                                                                                                                                                                                                                                            <h5 class="m-0">Resultado: <strong>@resultado</strong></h5>
                                                                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                                                                                </div>
                                                                                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                                                                                    </div>

                                                                                                                                                                                                                                                                                                    @code {
                                                                                                                                                                                                                                                                                                            private double num1;
                                                                                                                                                                                                                                                                                                                private double num2;
                                                                                                                                                                                                                                                                                                                    private string resultado = "0";

                                                                                                                                                                                                                                                                                                                        private void Sumar() => resultado = (num1 + num2).ToString();
                                                                                                                                                                                                                                                                                                                            private void Restar() => resultado = (num1 - num2).ToString();
                                                                                                                                                                                                                                                                                                                                private void Multiplicar() => resultado = (num1 * num2).ToString();
                                                                                                                                                                                                                                                                                                                                    private void Dividir()
                                                                                                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                                                                                                    if (num2 != 0)
                                                                                                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                                                                                                                            resultado = (num1 / num2).ToString();
                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                    else
                                                                                                                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                                                                                                                                            resultado = "No se puede dividir entre cero";
                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                    }